{
  "training": {
    "training_protocol": "adaptive_ensemble",
    "rounds": 4,
    "local_epochs": 3,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "batch_size": 1024,
    "negative_ratio": 20,
    "replay": "risk_context",
    "replay_size": 2000,
    "rng_policy": "per_client",
    "seed": 42,
    "hidden_channels": 128,
    "dropout": 0.25,
    "aggregation": "equal",
    "private_subset": "ensemble_decoder",
    "return_aggregate": true,
    "max_chunk_bytes": 524288
  },
  "bank_order": [
    "Key_Bank",
    "Wells_Fargo",
    "JPMorgan_Chase"
  ],
  "samples": 12,
  "rule": "ceil(1.25 * max(global ensemble decoder L2) / 0.5) * 0.5; minimum 0.5",
  "splits": [
    "training"
  ],
  "validation_loaded": false,
  "test_loaded": false,
  "disclosure": "Nonprivate research calibration; no DP claim for norm statistics or C selection"
}
